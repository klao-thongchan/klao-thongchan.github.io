{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "phase": 4,
  "name": "Legacy Decommissioning, Cleanup & LTS Governance",
  "environment": "Test / Staging",
  "status": "IMPLEMENTED_IN_TEST",
  "date": "2026-10-22",
  "version": "1.3.0",
  "php_runtime_decommissioning_runbook": {
    "step_1_terminate_services": [
      "systemctl stop php-fpm || true",
      "systemctl disable php-fpm || true",
      "docker compose -f docker-compose.legacy.yml down --volumes --remove-orphans || true"
    ],
    "step_2_remove_binaries": [
      "apt-get purge -y 'php*' 'libapache2-mod-php*' || apk del 'php*' || true",
      "rm -rf /etc/php /var/run/php /var/log/php-fpm"
    ],
    "step_3_firewall_and_socket_isolation": [
      "Verify port 9000 (FastCGI) is closed and not listening on any interface",
      "Delete dangling UNIX domain sockets (/run/php/php*-fpm.sock)",
      "Ensure edge reverse proxy (NGINX/Cloudflare) permanently routes to static/LTS upstream"
    ]
  },
  "repository_hygiene_retired_assets": [
    "test/tailwind.config.js",
    "test/css/tailwind-input.css",
    "test/css/tailwind.css",
    "test/css/site.css",
    "test/css/components.css",
    "test/css/print.css",
    "test/js/navigation.js",
    "test/js/timeline.js",
    "test/js/project-filter.js",
    "test/js/recruiter-view.js"
  ],
  "lts_governance_calendar": {
    "review_cadence": "Quarterly Security Audit + Annual Major LTS Version Upgrade",
    "node_lts_policy": {
      "active_target": "Node.js 22 LTS",
      "next_transition_window": "October 2027 (Transition to Node.js 24 LTS)",
      "automated_scanning": "npm audit --audit-level=high in CI pipelines"
    },
    "golang_policy": {
      "active_target": "Go 1.23+",
      "upgrade_window": "Within 30 days of standard minor releases (N and N-1 supported)"
    }
  }
}
